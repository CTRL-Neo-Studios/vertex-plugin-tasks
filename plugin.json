{
  "id": "tasks",
  "name": "Tasks",
  "version": "0.0.0",
  "description": "Todos, events and timelines in .task files: a list of reminders, a board, a calendar and a timeline.",
  "icon": "i-lucide-list-checks",
  "author": "CTRL Neo Studios",
  "repository": "https://github.com/CTRL-Neo-Studios/vertex-plugin-tasks",
  "apiVersion": 1,
  "config": {
    "overridable": {
      "weekStart": "workspace",
      "timeZone": "workspace"
    },
    "schema": [
      {
        "key": "weekStart",
        "type": "select",
        "label": "plugins.tasks.config.weekStart",
        "default": "auto",
        "options": [
          {"value": "auto", "label": "plugins.tasks.config.weekStartAuto"},
          {"value": "monday", "label": "plugins.tasks.config.monday"},
          {"value": "sunday", "label": "plugins.tasks.config.sunday"},
          {"value": "saturday", "label": "plugins.tasks.config.saturday"}
        ]
      },
      {
        "key": "timeZone",
        "type": "text",
        "label": "plugins.tasks.config.timeZone",
        "description": "plugins.tasks.config.timeZoneHelp",
        "default": "",
        "placeholder": "Europe/Berlin"
      }
    ]
  }
}
